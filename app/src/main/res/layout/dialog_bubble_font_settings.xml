<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bubble_font_settings_note"
            android:textColor="?attr/dialogHintTextColor"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/bubble_font_use_uploaded_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/bubble_font_use_uploaded"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:id="@+id/bubble_font_uploaded_file_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/dialogTextColor"
            android:textSize="14sp" />

        <Button
            android:id="@+id/bubble_font_upload_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bubble_font_upload_button" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/bubble_font_bold_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/bubble_font_bold"
            android:textColor="?attr/dialogTextColor" />
    </LinearLayout>
</ScrollView>
